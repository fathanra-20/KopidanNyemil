<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid warm creamy off-white base (#FAF7F4) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_app" />
        </shape>
    </item>

    <!-- Top-Right: Outer diffused soft rose aura -->
    <item
        android:gravity="top|end"
        android:width="440dp"
        android:height="440dp"
        android:top="-100dp"
        android:right="-100dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="@color/glow_top_rose_mid"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Top-Right: Inner rich dusty rose/berry glow -->
    <item
        android:gravity="top|end"
        android:width="300dp"
        android:height="300dp"
        android:top="-40dp"
        android:right="-40dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="@color/glow_top_rose"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Bottom-Left: Outer diffused warm peach aura -->
    <item
        android:gravity="bottom|start"
        android:width="460dp"
        android:height="460dp"
        android:bottom="-120dp"
        android:left="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="230dp"
                android:startColor="@color/glow_bottom_peach_mid"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Bottom-Left: Inner vivid warm peach/coral glow -->
    <item
        android:gravity="bottom|start"
        android:width="320dp"
        android:height="320dp"
        android:bottom="-50dp"
        android:left="-50dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:startColor="@color/glow_bottom_peach"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
